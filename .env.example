# Copy this file to .env and fill in your key.
# Get a Steam Web API key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Xbox and PlayStation catalogs (no console account connection needed).
# Get a RAWG API key at https://rawg.io/apidocs
RAWG_API_KEY=
# Where the browser reaches the app (the Vite dev server by default).
APP_URL=http://localhost:5173
